# 복사해서 .env (공통) 또는 .env.production (node server.js / npm start) 로 사용한다.
# .env.development 는 npm run dev 에서만 읽는다. 실제 환경변수와 CLI 인자가 항상 우선한다.
# 상대 경로는 서버를 실행한 폴더(cwd) 기준이다.

# 노트 루트 폴더 (기본: 현재 폴더)
NOTES_ROOT=

# docx 내보내기 템플릿(.docx) 폴더 (기본: 앱 폴더의 templates/)
NOTES_TEMPLATES=

# 서버 포트 (기본: 5273)
PORT=5273

# 번들(백업) 암호화 키 — 빌드 시 코드에 포함된다(보안이 아니라 난독화 수준). 임의의 긴 문자열을 넣는다.
# 비어 있으면 암호화(.mwb)·텔레그램 올리기를 쓸 수 없고 평문 zip 내보내기만 가능하다.
# 키를 바꾸면 이전 키로 만든 .mwb 는 새 빌드에서 열 수 없다. .env 는 gitignore 대상이다.
VITE_BUNDLE_KEY=

# 단일 HTML 빌드(npm run build:html)의 애니메이션 옵션: off 면 효과 없이 빌드하고 설정 토글도 숨긴다(기본 on).
# 서버·정적 빌드는 항상 on 이고 설정 화면에서 끌 수 있다.
ANIMATIONS=

# (선택) 개발 서버를 같은 Wi-Fi 의 폰 등에서 볼 때 .env.development.local 에만 넣는다 (커밋 금지).
# DEV_HOST=0.0.0.0 → LAN 에서 접속 가능. WORKS_ALLOWED_HOSTS → API 가 받아줄 Host(PC 의 IP, 쉼표 구분, 포트 제외).
# 노트 폴더를 읽고 쓰는 API 가 열리므로 공용 네트워크에서는 쓰지 않는다.
DEV_HOST=
WORKS_ALLOWED_HOSTS=
